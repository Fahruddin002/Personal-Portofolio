# Salin file ini menjadi .env.local lalu isi nilai aslinya.
# EMAIL_PASS HARUS Google App Password (16 karakter), bukan password Gmail biasa.
# Buat di: https://myaccount.google.com/apppasswords (wajib aktifkan 2-Step Verification)

EMAIL_USER=alamat@gmail.com
EMAIL_PASS=xxxxxxxxxxxxxxxx
EMAIL_TO=alamat@gmail.com

# Opsional: URL publik untuk canonical, Open Graph, dan sitemap.
# Set di Vercel kalau domainnya berbeda dari nilai di bawah.
NEXT_PUBLIC_SITE_URL=https://portofolio-faruk.vercel.app
